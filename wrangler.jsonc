{
  // wrangler isn't a devDependency — the deploy runs via cloudflare/wrangler-action,
  // so the schema is referenced by URL rather than a node_modules path that
  // resolves to nothing locally.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "mlz-design",
  "compatibility_date": "2026-08-07",
  "account_id": "1524bafd76d520ef1ce36c47a3f3bce1",
  "assets": {
    "directory": "./storybook-static",
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "design.mlz.no", "custom_domain": true }]
}
